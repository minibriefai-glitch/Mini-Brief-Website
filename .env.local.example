# Supabase — MiniBrief backend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable anon key — safe in the browser (used by the /admin dashboard).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The web app (cloud.minibrief.app) — where "Sign in" and "Get started" go.
# Inlined at build; change it in Vercel and redeploy.
NEXT_PUBLIC_PORTAL_URL=https://cloud.minibrief.app
